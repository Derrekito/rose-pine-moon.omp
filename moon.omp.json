{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "version": 2,
    "final_space": false,
    "console_title_template": "{{ .Shell }} in {{ .Folder }}",
    "palette": {
        "base": "#232136",
        "surface": "#2a273f",
        "overlay": "#393552",
        "muted": "#6e6a86",
        "subtle": "#908caa",
        "text": "#e0def4",
        "love": "#eb6f92",
        "gold": "#f6c177",
        "rose": "#ea9a97",
        "pine": "#3e8fb0",
        "foam": "#9ccfd8",
        "iris": "#c4a7e7",
        "highlight-low": "#2a283e",
        "highlight-med": "#44415a",
        "highlight-high": "#56526e",
        "true": "p:pine",
        "false": "p:love",
        "time": "p:muted",
        "step-0": "p:surface",
        "step-1": "p:highlight-high",
        "step-2": "p:overlay",
        "step-3": "p:highlight-med",
        "step-4": "p:surface",
        "moon": "p:iris",
        "root": "p:love",
        "lock": "p:gold",
        "battery": "p:gold",
        "session-fg": "p:text",
        "path-fg": "p:foam",
        "git-clean": "p:subtle",
        "git": "p:iris",
        "git-alert": "p:love",
        "docker": "p:foam",
        "venv": "p:pine"
    },
    "transient_prompt": {
        "foreground": "p:time",
        "template": "{{ now | date \"15:04:05\" }} {{ if gt .Code 0 }}<p:false>\u276f</>{{ else }}<p:true>\u276f</>{{ end }} "
    },
    "secondary_prompt": {
        "foreground": "p:time",
        "template": "\u276f\u276f "
    },
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "text",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "leading_powerline_symbol": "\u2590",
                    "foreground": "p:moon",
                    "background": "p:step-0",
                    "template": "{{ $i := mod (div (mul (mod (sub now.Unix 947182440) 2551443) 28) 2551443) 28 }}{{ printf \"%c\" (add 58253 $i) }} "
                },
                {
                    "type": "root",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "leading_powerline_symbol": "\u2590",
                    "foreground": "p:root",
                    "background": "p:step-0",
                    "template": "# "
                },
                {
                    "type": "session",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "leading_powerline_symbol": "\u2590",
                    "foreground": "p:session-fg",
                    "background": "p:step-1",
                    "template": "{{ if .SSHSession }} \ueb39 {{ .UserName }}@{{ .HostName }} {{ end }}"
                },
                {
                    "type": "path",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "leading_powerline_symbol": "\u2590",
                    "foreground": "p:path-fg",
                    "background": "p:step-2",
                    "template": " {{ if not .Writable }}<p:lock>\uf023</> {{ end }}{{ .Path }} ",
                    "options": {
                        "home_icon": "~",
                        "folder_icon": "\u2026",
                        "style": "agnoster_short",
                        "max_depth": 3
                    }
                },
                {
                    "type": "git",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "leading_powerline_symbol": "\u2590",
                    "foreground": "p:git-clean",
                    "background": "p:step-3",
                    "template": " {{ .HEAD }}{{ $c := .Working.Unmerged }}{{ if gt .Staging.Unmerged $c }}{{ $c = .Staging.Unmerged }}{{ end }}{{ if gt $c 0 }} \uf071 {{ $c }}{{ end }} ",
                    "foreground_templates": [
                        "{{ if or (gt .Working.Unmerged 0) (gt .Staging.Unmerged 0) .Rebase .Merge .CherryPick .Revert }}p:git-alert{{ end }}",
                        "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git{{ end }}"
                    ],
                    "options": {
                        "branch_icon": "\ue725 ",
                        "branch_gone_icon": "",
                        "cherry_pick_icon": "\ue29b ",
                        "commit_icon": "\uf417 ",
                        "fetch_status": true,
                        "fetch_stash_count": false,
                        "fetch_upstream_icon": false,
                        "merge_icon": "\ue727 ",
                        "no_commits_icon": "\uf0c3 ",
                        "rebase_icon": "\ue728 ",
                        "revert_icon": "\uf0e2 ",
                        "tag_icon": "\uf412 "
                    }
                },
                {
                    "type": "docker",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "leading_powerline_symbol": "\u2590",
                    "foreground": "p:docker",
                    "background": "p:step-4",
                    "template": " \uf308 {{ .Context }} "
                },
                {
                    "type": "python",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "leading_powerline_symbol": "\u2590",
                    "foreground": "p:venv",
                    "background": "p:step-4",
                    "template": "{{ if .Venv }} \ue73c {{ .Venv }} {{ end }}",
                    "options": {
                        "display_mode": "environment",
                        "fetch_version": false,
                        "fetch_virtual_env": true,
                        "display_default": false,
                        "home_enabled": true
                    }
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "right",
            "segments": [
                {
                    "type": "battery",
                    "style": "plain",
                    "foreground": "p:battery",
                    "template": "{{ if and (eq .State.String \"Discharging\") (le .Percentage 25) }}\udb80\udc83 {{ .Percentage }}% {{ end }}"
                },
                {
                    "type": "status",
                    "style": "plain",
                    "foreground": "p:false",
                    "template": "\uf00d {{ .Code }} "
                },
                {
                    "type": "executiontime",
                    "style": "plain",
                    "foreground": "p:true",
                    "foreground_templates": [
                        "{{ if .Code }}p:false{{ end }}"
                    ],
                    "template": "\udb81\udd1f {{ .FormattedMs }} ",
                    "options": {
                        "threshold": 500,
                        "style": "austin"
                    }
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "status",
                    "style": "plain",
                    "foreground": "p:true",
                    "foreground_templates": [
                        "{{ if gt .Code 0 }}p:false{{ end }}"
                    ],
                    "template": "\u276f ",
                    "options": {
                        "always_enabled": true
                    }
                }
            ]
        }
    ]
}
